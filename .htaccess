# www -> non-www canonical 301 (added 2026-07-04, reversible: delete this file)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.chatgptdisaster\.com [NC]
RewriteRule ^(.*)$ https://chatgptdisaster.com/$1 [R=301,L]

# 2026-09-10, recovery gate C: SportsBettingPrime material retired from this
# domain. 410 Gone rather than 404 because the removal is deliberate and
# permanent. Reversible by deleting these four lines.
RedirectMatch 410 ^/consensus_library(/.*)?$
RedirectMatch 410 ^/college-football\.html$
RewriteRule ^consensus_library(/|$) - [G,L]
RewriteRule ^college-football\.html$ - [G,L]
